{
  "format": "osr-feature-schema/v1",
  "version": "v1.0",
  "granularity": "sparse_row_signals_plus_shard_aggregates",
  "evidence_contract": "Every row-level feature keeps corpus/repo/shard/row/row_sha256. Derived features are candidates until exact source-row recheck.",
  "design": {
    "all_rows": [
      "row_count",
      "nonempty_row_count",
      "char_count",
      "utf8_byte_count",
      "cjk_char_count",
      "ascii_char_count",
      "digit_char_count",
      "newline_count",
      "sentence_terminal_count",
      "within_shard_duplicate_row_count"
    ],
    "sparse_rows_only": [
      "matched_feature_ids",
      "per_feature_counts",
      "first_positions",
      "explicit_year_mentions",
      "row_sha256",
      "text_length",
      "script_mix"
    ],
    "cooccurrence": "feature-pair row co-occurrence aggregated per shard",
    "raw_text_persisted": false
  },
