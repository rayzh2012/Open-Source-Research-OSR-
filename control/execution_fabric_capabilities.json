  "not_default": [
    {
      "mode": "universal_full_text_index",
      "reason": "Quickwit/Tantivy pilot expanded sampled text by 6.1566x; projected full-corpus storage is economically wasteful"
    },
    {
      "mode": "universal_qgram_index",
      "reason": "3-gram pilot expanded sampled text by 1.8198x; useful only for repeated high-value query families"
    },
    {
      "mode": "full_508GB_mac_scan",
      "reason": "Mac+rclone measured only 1.7-2.4 MiB/s and adds user-machine dependency"
    },
    {
      "mode": "persist_raw_corpus_in_github_artifacts",
      "reason": "raw data must remain upstream; runners use ephemeral shard hydration and persist only compact derivatives"
    }
  ],
  "current_priority": [
    "finish stage2-query-index-backfill-v1-001 across all 1788 shards",
    "materialize compact query index and verified corpus statistics",
    "add generic feature-extraction worker contract",
    "add validation/aggregation worker contract",
    "derive shard routing features so future semantic/mining jobs avoid rescanning irrelevant shards"
  ],
  "job_lifecycle": [
    "CLASSIFY",
    "SMOKE_1_SHARD",
    "VERIFY_OUTPUT",
    "SCALE_1_TO_20_WORKERS",
    "CHECKPOINT",
    "REDUCE",
    "PERSIST_COMPACT_DERIVATIVE",
    "VERIFY_READBACK",
    "WRITEBACK_NOTION"
  ],
  "economic_rule": "Build permanent derived data only when expected future I/O saved exceeds its storage/build cost; otherwise scan upstream shards on demand.",
