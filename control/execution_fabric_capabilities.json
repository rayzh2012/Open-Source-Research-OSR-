      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "graph_prep",
      "examples": ["entity mention edges", "co-occurrence edges", "source-row provenance", "candidate relation extraction"],
      "output": "edge/node candidate tables for downstream review",
      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "specialized_compact_index",
      "examples": ["q-gram locator for repeated query families"],
      "output": "bounded specialized index",
      "status": "OPTIONAL_AFTER_ECONOMIC_TEST"
    }
