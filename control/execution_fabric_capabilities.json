  "goal": "Turn large public corpora into compact reusable derived data while minimizing user interaction, machine-local work, and paid compute.",
  "execution_planes": {
    "default_public_compute": "GitHub Actions standard hosted runners",
    "private_local_state": "OSR Watcher on Mac only when genuinely required",
    "forbidden_without_explicit_approval": [
      "paid GitHub larger runners",
      "GPU runners",
      "paid VMs",
      "Colab paid compute",
      "Replit agent compute"
    ]
  },
  "supported_now": [
    {
      "mode": "direct_query_scan",
      "examples": ["exact substring", "multi-term Aho-Corasick scan", "term frequency", "hit locators", "bounded snippets"],
