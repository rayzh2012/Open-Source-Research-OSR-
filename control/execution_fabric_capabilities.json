      "status": "ACTIVE"
    },
    {
      "mode": "feature_extraction",
      "examples": ["length", "language/script mix", "keyword-family counts", "structural flags", "document-level features", "row-level features"],
      "output": "Parquet/JSONL/CSV feature store",
      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "aggregation",
      "examples": ["counts", "histograms", "top-k", "co-occurrence", "per-shard summaries", "per-corpus summaries"],
      "output": "small reducer tables",
      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "validation",
      "examples": ["schema checks", "row counts", "null rates", "duplicate indicators", "encoding checks", "range checks", "cross-shard invariants"],
      "output": "validation ledger + failure locators",
      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "transform",
      "examples": ["normalization", "field projection", "text cleaning", "chunking", "format conversion", "lightweight dedupe keys"],
      "output": "compact transformed derivatives",
      "status": "READY_TO_IMPLEMENT"
    },
    {
      "mode": "routing_index",
      "examples": ["which shards are relevant", "term-family routing", "high-yield shard ranking"],
